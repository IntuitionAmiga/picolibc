# IE64 uses the portable C implementations. Architecture-specific startup,
# platform hooks and atomics are supplied by the IE64 sysroot integration.

srcs_machine = [
  'clz.c',
  'fopen.c',
  'freopen.c',
  'ie64_file.c',
  'platform.c',
  'remove.c',
  'rename.c',
  'setjmp.s',
  'sbrk.c',
  'tmpfile.c',
]
src_machine = files(srcs_machine)
